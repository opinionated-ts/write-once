{
  "name": "write-once",
  "description": "Keep documentation, AI instructions, skills, and code examples in sync from a single source of truth. Reuse text across files with simple markers and avoid duplicated edits.",
  "keywords": [
    "content-synchronization",
    "documentation-sync",
    "fragment-reuse",
    "single-source-of-truth",
    "text-reuse",
    "text-synchronization",
    "write-once"
  ],
  "homepage": "https://github.com/opinionated-ts/write-once#readme",
  "bugs": {
    "url": "https://github.com/opinionated-ts/write-once/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Opinionated TS",
    "url": "https://github.com/opinionated-ts"
  },
  "contributors": [
    {
      "name": "Daniel A. Hernández Ochoa",
      "url": "https://github.com/DanhezCode"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/opinionated-ts/write-once.git"
  },
  "bin": {
    "write-once": "dist/cli.mjs"
  },
  "files": [
    "dist",
    "write-once.schema.json",
    "docs",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json",
    "./schema.json": "./write-once.schema.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "cspell": "cspell lint .",
    "fmt": "oxfmt --check .",
    "fmt:fix": "oxfmt .",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "check": "bun fmt && bun lint && bun cspell",
    "fix": "bun fmt:fix && bun lint:fix",
    "hooks:install": "lefthook install",
    "skills:install": "bun skills experimental_install",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "audit": "bun audit fix --ignore GHSA-vfj7-8cjw-p6xm",
    "build": "tsdown && bun run generate:schema",
    "build:watch": "tsdown --watch",
    "start": "bun run build && bun ./dist/cli.mjs",
    "generate:schema": "bun scripts/generate-schema.ts",
    "write-once": "bun dist/cli.mjs",
    "prepack": "bun run build"
  },
  "dependencies": {
    "@opinionated-ts/error-factory": "^1.0.1",
    "@opinionated-ts/result": "^1.0.0",
    "c12": "^3.3.3",
    "citty": "^0.2.2",
    "ignore": "^7.0.12",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@opinionated-ts/config": "^1.9.1",
    "@semantic-release/exec": "^7.1.0",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.4",
    "@vitest/coverage-istanbul": "5.0.3",
    "skills": "^1.7.1",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "zod": "^4.6.7"
  },
  "engines": {
    "bun": "^1.4.0"
  },
  "packageManager": "bun@1.4.0"
}
