{
  "name": "@opinionated-ts/write-once",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/opinionated-ts/write-once.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "cspell": "cspell lint .",
    "fmt": "oxfmt --check .",
    "fmt:fix": "oxfmt .",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "check": "bun fmt && bun lint && bun cspell",
    "fix": "bun fmt:fix && bun lint:fix",
    "hooks:install": "lefthook install",
    "skills:install": "bun skills experimental_install",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "audit": "bun audit fix --ignore GHSA-vfj7-8cjw-p6xm",
    "build": "tsdown",
    "build:watch": "tsdown --watch",
    "start": "bun run build && bun ./dist/index.mjs"
  },
  "dependencies": {
    "@opinionated-ts/error-factory": "^1.0.1",
    "@opinionated-ts/result": "^1.0.0"
  },
  "devDependencies": {
    "@opinionated-ts/config": "^1.9.1",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.4",
    "@vitest/coverage-istanbul": "5.0.3",
    "skills": "^1.7.1",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "bun": "^1.4.0"
  },
  "packageManager": "bun@1.4.0"
}
